generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum ApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
}

enum ParticipantStatus {
  ACTIVE
  PAUSED
  REMOVED
}

enum Position {
  TOP
  JUNGLE
  MIDDLE
  BOTTOM
  UTILITY
}

enum SeasonStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  FINALIZING
  COMPLETED
  ARCHIVED
}

enum ScoringMode {
  RANDOM_17_23
  FIXED_20
}

enum WeekStatus {
  SCHEDULED
  ACTIVE
  FINALIZING
  COMPLETED
}

enum SeasonParticipantStatus {
  ACTIVE
  PAUSED
  REMOVED
}

enum StreakType {
  WIN
  LOSS
}

enum SnapshotSource {
  RIOT_API
  MOCK
  ADMIN_IMPORT
}

enum RankSnapshotStatus {
  CAPTURED
  UNRANKED
  UNCHANGED
  API_ERROR
}

enum MatchStatus {
  INGESTED
  PROCESSING
  PROCESSED
  INVALID
  ERROR
}

enum DrawState {
  SEALED
  REVEALED
  REROLLED
  AUTO_REVEALED
  VOID
}

enum ScoreLedgerType {
  MATCH_INITIAL
  MATCH_REROLL_ADJUSTMENT
  ADMIN_ADJUSTMENT
  MATCH_INVALIDATION
  MATCH_REINSTATEMENT
  MIGRATION_ADJUSTMENT
}

enum BaselineStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  RETIRED
  REJECTED
}

enum TierBucket {
  PLATINUM
  EMERALD
  DIAMOND
  MASTER_PLUS
}

enum MvpAward {
  NONE
  MVP
  ACE
}

enum MvpEvaluationStatus {
  COMPLETED
  PENDING_BASELINE
  PENDING_DATA
  INVALID_MATCH
}

enum MissionCategory {
  RESULT
  COMBAT
  DAMAGE
  PROTECTION
  GROWTH
  VISION
  OBJECTIVE
  SURVIVAL
  MULTIKILL
  SPEED
  ENDURANCE
  TIMELINE
  BUILD
  POSITION
  RUNE
  CHAMPION
  CUMULATIVE
}

enum MissionKind {
  SINGLE
  CUMULATIVE
}

enum MissionDifficulty {
  EASY
  NORMAL
  HARD
  EPIC
}

enum MissionSourceType {
  MATCH_INFO
  MATCH_TIMELINE
  DATA_DRAGON
  DERIVED
  INTERNAL
}

enum MissionAssignmentState {
  ACTIVE
  COMPLETED
  REROLLED
  DEFERRED
  EXPIRED
  CANCELLED
}

enum MissionProgressEventType {
  NORMAL
  CORRECTION
}

enum MissionLedgerType {
  COMPLETION
  CORRECTION
  ADMIN_ADJUSTMENT
}

enum MissionCandidateStatus {
  UNSEEN
  ACTIVE
  COMPLETED
  DEFERRED
  EXHAUSTED
}

enum SyncTrigger {
  MANUAL
  GITHUB_SCHEDULE
  VERCEL_CRON
  WORKER
  OPPORTUNISTIC
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum SyncRunItemStatus {
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LegalDocumentType {
  RULES
  TERMS
  PRIVACY
  RIOT_DISCLAIMER
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ExportJobType {
  PARTICIPANTS
  MATCHES
  SCORE_LEDGER
  MISSION_LEDGER
  STANDINGS
  FULL_ARCHIVE
}

enum ExportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

model User {
  id                      String     @id @default(uuid()) @db.Uuid
  loginId                 String     @unique @db.VarChar(64)
  loginIdNormalized       String     @unique @db.VarChar(64)
  realName                String     @db.VarChar(100)
  realNamePublic          Boolean    @default(false)
  realNamePublicConsentAt DateTime?
  passwordHash            String
  role                    UserRole   @default(USER)
  status                  UserStatus @default(ACTIVE)
  sessionVersion          Int        @default(1)
  termsAcceptedAt         DateTime?
  privacyAcceptedAt       DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  lastLoginAt             DateTime?

  authSessions            AuthSession[]
  legalConsents           LegalConsent[]
  applications            ParticipationApplication[] @relation("ApplicationApplicant")
  reviewedApplications    ParticipationApplication[] @relation("ApplicationReviewer")
  participant             Participant?               @relation("ParticipantUser")
  approvedParticipants    Participant[]              @relation("ParticipantApprover")
  seasonsCreated          Season[]                   @relation("SeasonCreator")
  weekSnapshotsGenerated  WeekSnapshot[]             @relation("WeekSnapshotGenerator")
  finalSnapshotsGenerated FinalStandingSnapshot[]    @relation("FinalSnapshotGenerator")
  baselinesUploaded       MvpBaselineVersion[]       @relation("BaselineUploader")
  scoreLedgerEntries      ScoreLedger[]              @relation("ScoreLedgerActor")
  scoreReconciliations    ScoreReconciliation[]      @relation("ScoreReconciliationActor")
  missionCorrections      MissionProgressEvent[]     @relation("MissionCorrectionActor")
  missionLedgerEntries    MissionCompletionLedger[]  @relation("MissionLedgerActor")
  syncRunsRequested       SyncRun[]                  @relation("SyncRequester")
  announcementsCreated    Announcement[]             @relation("AnnouncementCreator")
  announcementsUpdated    Announcement[]             @relation("AnnouncementUpdater")
  legalDocumentsCreated   LegalDocument[]            @relation("LegalDocumentCreator")
  auditLogs               AuditLog[]                 @relation("AuditActor")
  featureFlagsUpdated     FeatureFlag[]              @relation("FeatureFlagUpdater")
  systemSettingsUpdated   SystemSetting[]            @relation("SystemSettingUpdater")
  exportJobsRequested     ExportJob[]                @relation("ExportRequester")

  @@index([status, createdAt])
}

model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  jtiHash        String    @unique @db.VarChar(128)
  sessionVersion Int
  expiresAt      DateTime
  revokedAt      DateTime?
  revokeReason   String?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LegalConsent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  legalDocumentId String   @db.Uuid
  acceptedAt      DateTime
  source          String   @db.VarChar(64)
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, legalDocumentId])
  @@index([legalDocumentId, acceptedAt])
}

model LoginAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  keyHash      String    @db.VarChar(128)
  windowStart  DateTime
  count        Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([keyHash, windowStart])
  @@index([blockedUntil])
}

model ParticipationApplication {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @db.Uuid
  gameName              String             @db.VarChar(128)
  tagLine               String             @db.VarChar(32)
  riotIdNormalized      String             @db.VarChar(192)
  puuid                 String?            @db.VarChar(128)
  summonerId            String?            @db.VarChar(128)
  profileIconId         Int?
  soloTier              String?            @db.VarChar(32)
  soloRank              String?            @db.VarChar(16)
  soloLeaguePoints      Int?
  primaryPosition       Position?
  secondaryPosition     Position?
  status                ApplicationStatus  @default(DRAFT)
  verificationStatus    VerificationStatus @default(NOT_STARTED)
  verificationErrorCode String?            @db.VarChar(64)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedById          String?            @db.Uuid
  reviewReason          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user       User  @relation("ApplicationApplicant", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([riotIdNormalized])
  @@index([puuid, status])
  @@index([status, submittedAt])
  @@index([userId, createdAt])
}

model Participant {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @unique @db.Uuid
  puuid              String            @unique @db.VarChar(128)
  summonerId         String?           @db.VarChar(128)
  gameName           String            @db.VarChar(128)
  tagLine            String            @db.VarChar(32)
  profileIconId      Int?
  primaryPosition    Position?
  secondaryPosition  Position?
  status             ParticipantStatus @default(ACTIVE)
  approvedAt         DateTime
  approvedById       String            @db.Uuid
  lastIdentitySyncAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User                         @relation("ParticipantUser", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy         User                         @relation("ParticipantApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  identityHistory    ParticipantIdentityHistory[]
  seasonEntries      SeasonParticipant[]
  participantWeeks   ParticipantWeek[]
  rankSnapshots      RankSnapshot[]
  dailySnapshots     DailyStandingSnapshot[]
  participantMatches ParticipantMatch[]
  syncCursor         SyncCursor?
  syncRunItems       SyncRunItem[]

  @@index([status, approvedAt])
  @@index([gameName, tagLine])
}

model ParticipantIdentityHistory {
  id            String    @id @default(uuid()) @db.Uuid
  participantId String    @db.Uuid
  gameName      String    @db.VarChar(128)
  tagLine       String    @db.VarChar(32)
  validFrom     DateTime
  validTo       DateTime?
  source        String    @db.VarChar(64)
  createdAt     DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, validFrom])
  @@index([participantId, validTo])
}

model Season {
  id                     String       @id @default(uuid()) @db.Uuid
  name                   String       @db.VarChar(100)
  slug                   String       @unique @db.VarChar(100)
  description            String?
  status                 SeasonStatus @default(DRAFT)
  timezone               String       @default("Asia/Seoul") @db.VarChar(64)
  startAt                DateTime
  endAt                  DateTime
  scoringMode            ScoringMode  @default(RANDOM_17_23)
  minGameDurationSeconds Int          @default(600)
  autoRevealHours        Int          @default(12)
  rulesVersion           String       @db.VarChar(64)
  config                 Json
  createdById            String       @db.Uuid
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  createdBy             User                   @relation("SeasonCreator", fields: [createdById], references: [id], onDelete: Restrict)
  weeks                 Week[]
  participants          SeasonParticipant[]
  rankSnapshots         RankSnapshot[]
  syncCursors           SyncCursor[]
  seasonMatches         SeasonMatch[]
  finalStandingSnapshot FinalStandingSnapshot?

  @@index([status, startAt, endAt])
}

model Week {
  id                    String     @id @default(uuid()) @db.Uuid
  seasonId              String     @db.Uuid
  number                Int
  name                  String     @db.VarChar(100)
  status                WeekStatus @default(SCHEDULED)
  startAt               DateTime
  endAt                 DateTime
  baselineVersionId     String?    @db.Uuid
  missionCatalogVersion String     @db.VarChar(64)
  rulesSnapshot         Json
  finalizedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  season           Season                  @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  baselineVersion  MvpBaselineVersion?     @relation(fields: [baselineVersionId], references: [id], onDelete: Restrict)
  participantWeeks ParticipantWeek[]
  weekSnapshot     WeekSnapshot?
  rankSnapshots    RankSnapshot[]
  dailySnapshots   DailyStandingSnapshot[]
  seasonMatches    SeasonMatch[]
  exportJobs       ExportJob[]

  @@unique([seasonId, number])
  @@index([status, startAt, endAt])
}

model SeasonParticipant {
  id                     String                  @id @default(uuid()) @db.Uuid
  seasonId               String                  @db.Uuid
  participantId          String                  @db.Uuid
  status                 SeasonParticipantStatus @default(ACTIVE)
  joinedAt               DateTime
  leftAt                 DateTime?
  exceptionReason        String?
  startingRankSnapshotId String?                 @db.Uuid
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  season               Season        @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  participant          Participant   @relation(fields: [participantId], references: [id], onDelete: Restrict)
  startingRankSnapshot RankSnapshot? @relation("StartingRankSnapshot", fields: [startingRankSnapshotId], references: [id], onDelete: SetNull)

  @@unique([seasonId, participantId])
  @@index([seasonId, status])
}

model ParticipantWeek {
  id                   String      @id @default(uuid()) @db.Uuid
  weekId               String      @db.Uuid
  participantId        String      @db.Uuid
  mainScoreCached      Int         @default(0)
  missionScoreCached   Int         @default(0)
  wins                 Int         @default(0)
  losses               Int         @default(0)
  currentStreakType    StreakType?
  currentStreakCount   Int         @default(0)
  bestWinStreak        Int         @default(0)
  mvpCount             Int         @default(0)
  aceCount             Int         @default(0)
  rankCached           Int?
  missionRankCached    Int?
  lastProcessedMatchAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  week                    Week                      @relation(fields: [weekId], references: [id], onDelete: Restrict)
  participant             Participant               @relation(fields: [participantId], references: [id], onDelete: Restrict)
  participantMatches      ParticipantMatch[]
  scoreLedger             ScoreLedger[]
  reconciliations         ScoreReconciliation[]
  missionAssignments      WeeklyMissionAssignment[]
  missionCompletionLedger MissionCompletionLedger[]
  missionRefillState      MissionRefillState?
  missionRerollState      MissionRerollState?
  missionCandidateHistory MissionCandidateHistory[]

  @@unique([weekId, participantId])
  @@index([weekId, mainScoreCached, wins, losses])
  @@index([weekId, missionScoreCached])
}

model WeekSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  weekId           String   @unique @db.Uuid
  generatedAt      DateTime
  rulesSnapshot    Json
  standings        Json
  missionStandings Json
  highlights       Json
  checksum         String   @db.VarChar(128)
  generatedById    String?  @db.Uuid

  week        Week  @relation(fields: [weekId], references: [id], onDelete: Restrict)
  generatedBy User? @relation("WeekSnapshotGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
}

model FinalStandingSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  seasonId         String   @unique @db.Uuid
  generatedAt      DateTime
  rulesSnapshot    Json
  weekSnapshotRefs Json
  standings        Json
  highlights       Json
  checksum         String   @db.VarChar(128)
  generatedById    String?  @db.Uuid

  season      Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  generatedBy User?  @relation("FinalSnapshotGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
}

model RankSnapshot {
  id             String             @id @default(uuid()) @db.Uuid
  participantId  String             @db.Uuid
  seasonId       String?            @db.Uuid
  weekId         String?            @db.Uuid
  capturedAt     DateTime
  queueType      String             @db.VarChar(64)
  tier           String?            @db.VarChar(32)
  rank           String?            @db.VarChar(16)
  leaguePoints   Int?
  wins           Int?
  losses         Int?
  isUnranked     Boolean            @default(false)
  displayOrdinal Int?
  source         SnapshotSource
  status         RankSnapshotStatus @default(CAPTURED)
  errorCode      String?            @db.VarChar(64)
  raw            Json?
  createdAt      DateTime           @default(now())

  participant           Participant         @relation(fields: [participantId], references: [id], onDelete: Restrict)
  season                Season?             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  week                  Week?               @relation(fields: [weekId], references: [id], onDelete: Restrict)
  startingSeasonEntries SeasonParticipant[] @relation("StartingRankSnapshot")

  @@index([participantId, capturedAt])
  @@index([weekId, capturedAt])
  @@index([seasonId, capturedAt])
}

model DailyStandingSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  weekId        String   @db.Uuid
  participantId String   @db.Uuid
  localDate     DateTime @db.Date
  mainScore     Int
  rank          Int
  wins          Int
  losses        Int
  tier          String?  @db.VarChar(32)
  rankLabel     String?  @db.VarChar(16)
  leaguePoints  Int?
  createdAt     DateTime @default(now())

  week        Week        @relation(fields: [weekId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([weekId, participantId, localDate])
  @@index([weekId, localDate, rank])
}

model Match {
  id                String      @id @default(uuid()) @db.Uuid
  riotMatchId       String      @unique @db.VarChar(128)
  regionalRoute     String      @db.VarChar(32)
  queueId           Int
  mapId             Int
  gameMode          String      @db.VarChar(64)
  gameType          String      @db.VarChar(64)
  gameVersion       String      @db.VarChar(64)
  gameStartAt       DateTime
  gameEndAt         DateTime
  durationSeconds   Int
  earlySurrender    Boolean     @default(false)
  status            MatchStatus @default(INGESTED)
  invalidReason     String?
  rawSummary        Json?
  rawTimeline       Json?
  timelineFetchedAt DateTime?
  ingestedAt        DateTime    @default(now())
  processedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  seasonMatches   SeasonMatch[]
  teams           MatchTeam[]
  rawParticipants MatchParticipantRaw[]

  @@index([gameStartAt])
  @@index([queueId, gameStartAt])
  @@index([status, ingestedAt])
}

model SeasonMatch {
  id                String      @id @default(uuid()) @db.Uuid
  seasonId          String      @db.Uuid
  matchId           String      @db.Uuid
  weekId            String      @db.Uuid
  status            MatchStatus @default(INGESTED)
  eligibilityReason String?
  processedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  season             Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  match              Match              @relation(fields: [matchId], references: [id], onDelete: Restrict)
  week               Week               @relation(fields: [weekId], references: [id], onDelete: Restrict)
  participantMatches ParticipantMatch[]
  mvpEvaluations     MvpEvaluation[]

  @@unique([seasonId, matchId])
  @@index([weekId, status])
  @@index([seasonId, status, processedAt])
}

model MatchTeam {
  id             String  @id @default(uuid()) @db.Uuid
  matchId        String  @db.Uuid
  teamId         Int
  win            Boolean
  championKills  Int     @default(0)
  towerKills     Int     @default(0)
  inhibitorKills Int     @default(0)
  dragonKills    Int     @default(0)
  baronKills     Int     @default(0)
  heraldKills    Int     @default(0)
  objectives     Json

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId])
}

model MatchParticipantRaw {
  id                   String      @id @default(uuid()) @db.Uuid
  matchId              String      @db.Uuid
  puuid                String      @db.VarChar(128)
  teamId               Int
  participantIndex     Int
  position             Position?
  startingTier         String?     @db.VarChar(32)
  tierBucket           TierBucket?
  championId           Int
  championName         String      @db.VarChar(64)
  win                  Boolean
  kills                Int
  deaths               Int
  assists              Int
  totalMinionsKilled   Int
  neutralMinionsKilled Int
  goldEarned           Int
  damageToChampions    Int
  damageTaken          Int
  damageMitigated      Int
  damageToObjectives   Int
  damageToTurrets      Int
  visionScore          Int
  wardsPlaced          Int
  wardsKilled          Int
  controlWardsPlaced   Int
  timeCCingOthers      Int
  healOnTeammates      Int
  shieldOnTeammates    Int
  items                Json
  perks                Json
  summonerSpells       Json
  challenges           Json
  normalizedMetrics    Json
  createdAt            DateTime    @default(now())

  match              Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participantMatches ParticipantMatch[]
  mvpEvaluations     MvpEvaluation[]

  @@unique([matchId, participantIndex])
  @@index([matchId, teamId])
  @@index([puuid, matchId])
}

model ParticipantMatch {
  id                    String    @id @default(uuid()) @db.Uuid
  participantId         String    @db.Uuid
  participantWeekId     String    @db.Uuid
  seasonMatchId         String    @db.Uuid
  matchParticipantRawId String    @db.Uuid
  eligible              Boolean
  eligibilityReason     String?
  win                   Boolean
  position              Position?
  championId            Int
  championName          String    @db.VarChar(64)
  kills                 Int
  deaths                Int
  assists               Int
  cs                    Int
  kda                   Decimal   @db.Decimal(12, 4)
  killParticipation     Decimal?  @db.Decimal(8, 6)
  pointSignedCached     Int?
  processedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  participant           Participant               @relation(fields: [participantId], references: [id], onDelete: Restrict)
  participantWeek       ParticipantWeek           @relation(fields: [participantWeekId], references: [id], onDelete: Restrict)
  seasonMatch           SeasonMatch               @relation(fields: [seasonMatchId], references: [id], onDelete: Restrict)
  matchParticipantRaw   MatchParticipantRaw       @relation(fields: [matchParticipantRawId], references: [id], onDelete: Restrict)
  pointDraw             PointDraw?
  scoreLedger           ScoreLedger[]
  completedAssignments  WeeklyMissionAssignment[] @relation("AssignmentCompletionMatch")
  missionProgressEvents MissionProgressEvent[]
  missionMatchSnapshot  MissionMatchSnapshot?
  mvpEvaluations        MvpEvaluation[]

  @@unique([participantId, seasonMatchId])
  @@index([matchParticipantRawId])
  @@index([participantWeekId, createdAt])
  @@index([participantWeekId, eligible, seasonMatchId])
  @@index([participantWeekId, seasonMatchId])
}

model PointDraw {
  id                              String    @id @default(uuid()) @db.Uuid
  participantMatchId              String    @unique @db.Uuid
  state                           DrawState @default(SEALED)
  resultSign                      Int
  firstValue                      Int
  firstNonceEncryptedOrProtected  String
  firstCommitment                 String    @db.VarChar(128)
  firstCommitmentVersion          String    @default("v1") @db.VarChar(32)
  firstRngVersion                 String    @db.VarChar(64)
  firstGeneratedAt                DateTime
  revealedAt                      DateTime?
  autoRevealed                    Boolean   @default(false)
  rerollEligible                  Boolean   @default(false)
  rerollReason                    String?
  rerollEntitlementKey            String?   @unique @db.VarChar(192)
  rerollEntitlementSource         String?   @db.VarChar(32)
  rerollGrantedAt                 DateTime?
  rerollExpiresAt                 DateTime?
  rerollDemoOnly                  Boolean   @default(false)
  secondValue                     Int?
  secondNonceEncryptedOrProtected String?
  secondCommitment                String?   @db.VarChar(128)
  secondCommitmentVersion         String?   @db.VarChar(32)
  secondRngVersion                String?   @db.VarChar(64)
  rerollUsedAt                    DateTime?
  finalValue                      Int
  finalSignedValue                Int
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  participantMatch ParticipantMatch @relation(fields: [participantMatchId], references: [id], onDelete: Restrict)

  @@index([state, firstGeneratedAt])
  @@index([rerollEligible, rerollUsedAt])
}

model ScoreLedger {
  id                 String          @id @default(uuid()) @db.Uuid
  participantWeekId  String          @db.Uuid
  participantMatchId String?         @db.Uuid
  type               ScoreLedgerType
  amount             Int
  idempotencyKey     String          @unique @db.VarChar(192)
  reason             String?
  actorUserId        String?         @db.Uuid
  metadata           Json?
  createdAt          DateTime        @default(now())

  participantWeek  ParticipantWeek   @relation(fields: [participantWeekId], references: [id], onDelete: Restrict)
  participantMatch ParticipantMatch? @relation(fields: [participantMatchId], references: [id], onDelete: Restrict)
