# PostgreSQL. Use a dedicated local database; never commit real credentials.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deluxe_soloq
# Optional direct connection used by migration tooling when DATABASE_URL is pooled.
DIRECT_URL=

# Replace all values with independent random strings of at least 32 characters.
AUTH_SECRET=
CRON_SECRET=
# Dedicated AES key material for sealed draw nonces; required in production.
POINT_DRAW_SECRET=

# RIOT_API_KEY is required only when MOCK_RIOT_API=false.
RIOT_API_KEY=
RIOT_PLATFORM_REGION=KR
RIOT_REGIONAL_ROUTE=ASIA
MOCK_RIOT_API=true

SYNC_MODE=MANUAL
SYNC_BATCH_SIZE=5
SYNC_OVERLAP_MINUTES=30
SYNC_TIME_BUDGET_MS=20000
SYNC_MATCH_PAGE_SIZE=20
SYNC_PARTICIPANT_COOLDOWN_SECONDS=60
SYNC_LEASE_SECONDS=120
# Extra safety window before an expired lease may be reclaimed.
SYNC_LEASE_RECOVERY_GRACE_SECONDS=30
POINT_MODE=RANDOM_17_23
AUTO_REVEAL_HOURS=12
ALLOW_DEMO_MVP_REWARDS=false

APP_URL=http://localhost:3000
APP_TIME_ZONE=Asia/Seoul
NEXT_PUBLIC_POLL_INTERVAL_MS=20000

# Integration database preparation. Must differ from DATABASE_URL.
TEST_DATABASE_URL=
# Playwright base database. The runner creates and drops an isolated schema per spec.
# Must differ from DATABASE_URL and TEST_DATABASE_URL.
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deluxe_soloq_e2e

# Optional development seed login password. Never use the documented default in production.
SEED_PASSWORD=
